<!-- SERVICE_WXML_FIXED_V2 -->
<view class="page">
  <view class="hd">
    <view class="hd__title">一站式便民服务</view>
    <view class="hd__sub ellipsis">{{merchantName}}</view>
    <view class="hd__cart" bindtap="goCart">
      <mp-icon type="shop" size="20" color="#07C160"></mp-icon>
      <mp-badge wx:if="{{cartCount > 0}}" content="{{cartCount}}" style="margin-left:6rpx"></mp-badge>
    </view>
  </view>

  <scroll-view class="tabs" scroll-x>
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      class="tab {{activeTab === index ? 'is-on' : ''}}"
      data-i="{{index}}"
      bindtap="onTab"
    >{{item}}</view>
  </scroll-view>

  <view class="list">
    <service-card
      wx:for="{{list}}"
      wx:key="id"
      service="{{item}}"
      bind:open="onService"
      bind:qty="onQty"
    />
    <empty-box wx:if="{{!list.length}}" text="暂无服务"></empty-box>
    <view class="weui-footer" wx:if="{{list.length}}">已经到底了</view>
  </view>
  <service-fab></service-fab>
</view>
